# Server Environment
NODE_ENV=production
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# OpenFOAM Sandbox Execution Mode: 'local', 'wsl', or 'docker'
OPENFOAM_EXEC_MODE=wsl
CASE_TIMEOUT_MS=600000
MAX_CONCURRENT_JOBS=10

# Cryptographic Keys (MUST BE >= 32 CHARACTERS IN PRODUCTION)
# Generate using: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_min_32_character_cryptographically_secure_access_secret_2026
JWT_REFRESH_SECRET=replace_with_min_32_character_cryptographically_secure_refresh_secret_2026

# Logging Level: trace, debug, info, warn, error
LOG_LEVEL=info

# Optional External Database (PostgreSQL with TLS)
# DATABASE_URL=postgresql://cfd_user:cfd_secure_pass@localhost:5432/cfd_db?sslmode=require
